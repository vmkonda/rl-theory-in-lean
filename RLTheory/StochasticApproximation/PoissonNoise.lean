import RLTheory.StochasticApproximation.MultiplicativeNoiseCovariance

/-!
# Noise generated by a finite Markov chain

Section 4.1 of `docs/markov-sa-covariance.md`: for noise `V k = v (Y k) (Y (k+1))` driven by
a Markov chain on a finite set, a solution `ĥ` of the Poisson equation `ĥ - Q ĥ = v̄` gives the
decomposition `V k = M (k+1) + h k - h (k+1)` of Assumption 1.4, with `h k = ĥ (Y k)` and
`M (k+1)` a martingale difference; the covariances `E[M Mᵀ]` converge when the law of `Y k`
does.

* `FiniteMarkov`: the Markov property, stated for functions of two consecutive states.
* `poisson_decomposition`: Lemma 4.1 (the decomposition and the martingale property).
* `tendsto_secondMoment_poissonMart`: `E[M (k+1) M (k+1)ᵀ] → Σ_s ν s m s`.
* `tendsto_secondMoment_of_finite_markov_noise`: Corollary 4.3, Theorem 2.1 for finite-chain
  noise.
-/

open Filter Topology Finset Real Matrix MeasureTheory RLTheory
open scoped InnerProductSpace RealInnerProductSpace ENNReal

namespace StochasticApproximation

variable {d : ℕ} {Ω : Type*} {m0 : MeasurableSpace Ω} {μ : Measure Ω}
  {S : Type*} [Fintype S] [MeasurableSpace S] [DiscreteMeasurableSpace S]

/-- A Markov chain on a finite set with transition matrix `Q`, adapted to `ℱ`. The Markov
property is stated for functions of two consecutive states. -/
structure FiniteMarkov (μ : Measure Ω) (ℱ : MeasureTheory.Filtration ℕ m0) (Y : ℕ → Ω → S)
    (Q : S → S → ℝ) : Prop where
  adapted : ∀ k, Measurable[ℱ k] (Y k)
  stochastic : ∀ s, ∑ s', Q s s' = 1
  markov : ∀ k (F : S → S → ℝ), μ[fun ω => F (Y k ω) (Y (k + 1) ω) | ℱ k] =ᵐ[μ]
    fun ω => ∑ s', Q (Y k ω) s' * F (Y k ω) s'

/-- The conditional mean `v̄ s = Σ_{s'} Q s s' v s s'`. -/
noncomputable def condMean (Q : S → S → ℝ) (v : S → S → E d) (s : S) : E d :=
  ∑ s', Q s s' • v s s'

/-- `Q ĥ`. -/
noncomputable def applyQ (Q : S → S → ℝ) (f : S → E d) (s : S) : E d := ∑ s', Q s s' • f s'

/-- The martingale part of the Poisson decomposition. -/
noncomputable def poissonMart (Q : S → S → ℝ) (v : S → S → E d) (hh : S → E d) (s s' : S) : E d :=
  v s s' - condMean Q v s + hh s' - applyQ Q hh s

lemma euclid_sum_apply' {ι : Type*} (t : Finset ι) (f : ι → E d) (j : Fin d) :
    (∑ i ∈ t, f i) j = ∑ i ∈ t, f i j :=
  map_sum (EuclideanSpace.proj (𝕜 := ℝ) j) f t

omit [MeasurableSpace S] [DiscreteMeasurableSpace S] in
/-- Lemma 4.1, the algebraic part: `v = M + ĥ - ĥ'`. -/
lemma poisson_decomposition_eq (Q : S → S → ℝ) (v : S → S → E d) (hh : S → E d)
    (hP : ∀ s, hh s - applyQ Q hh s = condMean Q v s) (s s' : S) :
    v s s' = poissonMart Q v hh s s' + hh s - hh s' := by
  have := hP s
  simp only [poissonMart]
  rw [← this]
  abel

omit [DiscreteMeasurableSpace S] in
/-- Lemma 4.1, the probabilistic part: `M (k+1)` is a martingale difference. -/
lemma condExp_poissonMart_eq_zero {ℱ : MeasureTheory.Filtration ℕ m0} {Y : ℕ → Ω → S}
    {Q : S → S → ℝ} (hY : FiniteMarkov μ ℱ Y Q) (v : S → S → E d) (hh : S → E d) (k : ℕ)
    (j : Fin d) :
    μ[fun ω => poissonMart Q v hh (Y k ω) (Y (k + 1) ω) j | ℱ k] =ᵐ[μ] 0 := by
  filter_upwards [hY.markov k (fun s s' => poissonMart Q v hh s s' j)] with ω hω
  rw [hω]
  simp only [poissonMart, condMean, applyQ, PiLp.add_apply, PiLp.sub_apply, euclid_sum_apply',
    PiLp.smul_apply, smul_eq_mul, Pi.zero_apply]
  simp only [mul_add, mul_sub, sum_add_distrib, sum_sub_distrib, ← sum_mul, hY.stochastic,
    one_mul]
  ring

/-! ### Measurability and moments -/

section Moments

variable {ℱ : MeasureTheory.Filtration ℕ m0} {Y : ℕ → Ω → S} {Q : S → S → ℝ}

lemma FiniteMarkov.stronglyMeasurable (hY : FiniteMarkov μ ℱ Y Q) (f : S → E d) (k : ℕ) :
    StronglyMeasurable[ℱ k] fun ω => f (Y k ω) :=
  (StronglyMeasurable.of_discrete (f := f)).comp_measurable (hY.adapted k)

lemma FiniteMarkov.stronglyMeasurable₂ (hY : FiniteMarkov μ ℱ Y Q) (F : S → S → E d) (k : ℕ) :
    StronglyMeasurable[ℱ (k + 1)] fun ω => F (Y k ω) (Y (k + 1) ω) := by
  have h1 : Measurable[ℱ (k + 1)] (Y k) :=
    (hY.adapted k).mono (ℱ.mono (Nat.le_succ k)) le_rfl
  have h2 := h1.prodMk (hY.adapted (k + 1))
  exact (StronglyMeasurable.of_discrete (f := Function.uncurry F)).comp_measurable h2

lemma norm_le_sum_norm {ι : Type*} [Fintype ι] (f : ι → E d) (i : ι) : ‖f i‖ ≤ ∑ j, ‖f j‖ :=
  single_le_sum (f := fun j => ‖f j‖) (fun _ _ => norm_nonneg _) (mem_univ i)

lemma memLp_of_finite [IsFiniteMeasure μ] {g : Ω → E d} (hg : AEStronglyMeasurable g μ) {C : ℝ}
    (hC : ∀ ω, ‖g ω‖ ≤ C) : MemLp g 2 μ :=
  MemLp.of_bound hg C (Eventually.of_forall hC)

lemma FiniteMarkov.memLp (hY : FiniteMarkov μ ℱ Y Q) [IsFiniteMeasure μ] (f : S → E d) (k : ℕ) :
    MemLp (fun ω => f (Y k ω)) 2 μ :=
  memLp_of_finite ((hY.stronglyMeasurable f k).mono (ℱ.le k)).aestronglyMeasurable
    fun ω => norm_le_sum_norm f (Y k ω)

omit [MeasurableSpace S] [DiscreteMeasurableSpace S] in
lemma norm_le_sum_sum_norm (F : S → S → E d) (a b : S) : ‖F a b‖ ≤ ∑ s, ∑ s', ‖F s s'‖ :=
  (norm_le_sum_norm (F a) b).trans (single_le_sum (f := fun s => ∑ s', ‖F s s'‖)
    (fun _ _ => sum_nonneg fun _ _ => norm_nonneg _) (mem_univ a))

lemma FiniteMarkov.memLp₂ (hY : FiniteMarkov μ ℱ Y Q) [IsFiniteMeasure μ] (F : S → S → E d)
    (k : ℕ) : MemLp (fun ω => F (Y k ω) (Y (k + 1) ω)) 2 μ :=
  memLp_of_finite ((hY.stronglyMeasurable₂ F k).mono (ℱ.le (k + 1))).aestronglyMeasurable
    fun ω => norm_le_sum_sum_norm F (Y k ω) (Y (k + 1) ω)

lemma euclid_sum_apply₂ {ι κ : Type*} [Fintype κ] (t : Finset ι) (f : ι → EuclideanSpace ℝ κ)
    (j : κ) : (∑ i ∈ t, f i) j = ∑ i ∈ t, f i j :=
  map_sum (EuclideanSpace.proj (𝕜 := ℝ) j) f t

omit [MeasurableSpace S] [DiscreteMeasurableSpace S] in
lemma integral_sq_le_of_finite [IsProbabilityMeasure μ] (f : S → E d) (Z : Ω → S) :
    ∫ ω, ‖f (Z ω)‖ ^ 2 ∂μ ≤ (∑ s, ‖f s‖) ^ 2 := by
  have h : ∀ ω, ‖f (Z ω)‖ ^ 2 ≤ (∑ s, ‖f s‖) ^ 2 := fun ω =>
    pow_le_pow_left₀ (norm_nonneg _) (norm_le_sum_norm f (Z ω)) 2
  calc ∫ ω, ‖f (Z ω)‖ ^ 2 ∂μ ≤ ∫ _ω, (∑ s, ‖f s‖) ^ 2 ∂μ :=
        integral_mono_of_nonneg (Eventually.of_forall fun _ => by positivity)
          (integrable_const _) (Eventually.of_forall h)
    _ = _ := by simp

/-- `E[H(Y k)] = Σ_s P(Y k = s) H s`. -/
lemma integral_comp_finite [IsProbabilityMeasure μ] (hY : FiniteMarkov μ ℱ Y Q) (H : S → ℝ)
    (k : ℕ) : ∫ ω, H (Y k ω) ∂μ = ∑ s, μ.real {ω | Y k ω = s} * H s := by
  have hm : Measurable (Y k) := (hY.adapted k).mono (ℱ.le k) le_rfl
  rw [← integral_map hm.aemeasurable (Measurable.of_discrete (f := H)).aestronglyMeasurable,
    integral_fintype _ (Integrable.of_finite)]
  refine sum_congr rfl fun s _ => ?_
  rw [smul_eq_mul, Measure.real, Measure.map_apply hm (measurableSet_singleton s)]
  rfl

/-- The exact covariance of two functions of consecutive states. -/
lemma crossMoment_finite_eq [IsProbabilityMeasure μ] (hY : FiniteMarkov μ ℱ Y Q)
    (F G : S → S → E d) (k : ℕ) :
    crossMoment μ (fun ω => F (Y k ω) (Y (k + 1) ω)) (fun ω => G (Y k ω) (Y (k + 1) ω)) =
      ∑ s, μ.real {ω | Y k ω = s} • ∑ s', Q s s' • outer (F s s') (G s s') := by
  ext ij
  rw [crossMoment_apply (hY.memLp₂ F k) (hY.memLp₂ G k)]
  have hint : Integrable (fun ω => F (Y k ω) (Y (k + 1) ω) ij.1 * G (Y k ω) (Y (k + 1) ω) ij.2) μ :=
    (memLp_apply (hY.memLp₂ F k) ij.1).integrable_mul (memLp_apply (hY.memLp₂ G k) ij.2)
  rw [← integral_condExp (ℱ.le k) (f := fun ω => F (Y k ω) (Y (k + 1) ω) ij.1
    * G (Y k ω) (Y (k + 1) ω) ij.2)]
  rw [integral_congr_ae (hY.markov k (fun s s' => F s s' ij.1 * G s s' ij.2))]
  rw [integral_comp_finite hY (fun s => ∑ s', Q s s' * (F s s' ij.1 * G s s' ij.2)) k]
  rw [euclid_sum_apply₂]
  refine sum_congr rfl fun s _ => ?_
  rw [PiLp.smul_apply, euclid_sum_apply₂, smul_eq_mul]
  congr 1

/-- The covariances converge when the law of the chain does. -/
lemma tendsto_crossMoment_finite [IsProbabilityMeasure μ] (hY : FiniteMarkov μ ℱ Y Q)
    (F G : S → S → E d) {ν : S → ℝ}
    (hlaw : ∀ s, Tendsto (fun k => μ.real {ω | Y k ω = s}) atTop (𝓝 (ν s))) :
    Tendsto (fun k => crossMoment μ (fun ω => F (Y k ω) (Y (k + 1) ω))
        (fun ω => G (Y k ω) (Y (k + 1) ω))) atTop
      (𝓝 (∑ s, ν s • ∑ s', Q s s' • outer (F s s') (G s s'))) := by
  simp_rw [crossMoment_finite_eq hY F G]
  exact tendsto_finset_sum _ fun s _ => (hlaw s).smul_const _

end Moments

/-! ### Theorem 2.1 for finite-chain noise -/

omit [MeasurableSpace S] [DiscreteMeasurableSpace S] in
lemma integral_sq_le_of_finite₂ [IsProbabilityMeasure μ] (F : S → S → E d) (Z Z' : Ω → S) :
    ∫ ω, ‖F (Z ω) (Z' ω)‖ ^ 2 ∂μ ≤ (∑ s, ∑ s', ‖F s s'‖) ^ 2 := by
  have h : ∀ ω, ‖F (Z ω) (Z' ω)‖ ^ 2 ≤ (∑ s, ∑ s', ‖F s s'‖) ^ 2 := fun ω =>
    pow_le_pow_left₀ (norm_nonneg _) (norm_le_sum_sum_norm F (Z ω) (Z' ω)) 2
  calc ∫ ω, ‖F (Z ω) (Z' ω)‖ ^ 2 ∂μ ≤ ∫ _ω, (∑ s, ∑ s', ‖F s s'‖) ^ 2 ∂μ :=
        integral_mono_of_nonneg (Eventually.of_forall fun _ => by positivity)
          (integrable_const _) (Eventually.of_forall h)
    _ = _ := by simp

/-- **Corollary 4.3 of the write-up.** Linear stochastic approximation driven by a finite
Markov chain, `θ (k+1) = θ k - β k A θ k + β k v (Y k) (Y (k+1))`, with a solution `ĥ` of the
Poisson equation and the law of `Y k` converging to `ν`, has `β k⁻¹ E[θ k θ kᵀ] → Σ`, where
`Σ` solves the Lyapunov equation with `Γ = Σ_s ν s Σ_{s'} Q s s' M s s' (M s s')ᵀ` and
`M = v - v̄ + ĥ' - Q ĥ` the martingale part of the noise. -/
theorem tendsto_secondMoment_of_finite_markov_noise [IsProbabilityMeasure μ] {β : ℕ → ℝ}
    {βbar : ℝ} (hβ : StepSizeRate β βbar) (A : Matrix (Fin d) (Fin d) ℝ) {η : ℝ} (hη : 0 < η)
    (hA : ∀ x, η * (x ⬝ᵥ x) ≤ x ⬝ᵥ ((A - (βbar / 2) • 1) *ᵥ x))
    {ℱ : MeasureTheory.Filtration ℕ m0} {Y : ℕ → Ω → S} {Q : S → S → ℝ}
    (hY : FiniteMarkov μ ℱ Y Q) (v : S → S → E d) (hh : S → E d)
    (hP : ∀ s, hh s - applyQ Q hh s = condMean Q v s) {ν : S → ℝ}
    (hlaw : ∀ s, Tendsto (fun k => μ.real {ω | Y k ω = s}) atTop (𝓝 (ν s)))
    {θ : ℕ → Ω → E d}
    (hθ : ∀ k ω, θ (k + 1) ω = θ k ω - β k • matCLM A (θ k ω) + β k • v (Y k ω) (Y (k + 1) ω))
    (hθ0 : StronglyMeasurable[ℱ 0] (θ 0)) (hθ0L : MemLp (θ 0) 2 μ) :
    ∃ Sig, lyapOp (A - (βbar / 2) • 1) Sig =
        ∑ s, ν s • ∑ s', Q s s' • outer (poissonMart Q v hh s s') (poissonMart Q v hh s s') ∧
      Tendsto (fun k => (β k)⁻¹ • secondMoment μ (θ k)) atTop (𝓝 Sig) := by
  set Mf := poissonMart Q v hh
  refine tendsto_secondMoment_of_markov_noise hβ A hη hA ℱ
    (M := fun n ω => Mf (Y n.pred ω) (Y n ω)) (h := fun n ω => hh (Y n ω)) ?_ hθ0 hθ0L
    (fun k => hY.stronglyMeasurable hh k) (fun k => hY.memLp hh k)
    ⟨_, fun k => integral_sq_le_of_finite hh (Y k)⟩
    (fun k => hY.stronglyMeasurable₂ Mf k) (fun k => hY.memLp₂ Mf k)
    ⟨_, fun k => integral_sq_le_of_finite₂ Mf (Y k) (Y (k + 1))⟩
    (fun k j => condExp_poissonMart_eq_zero hY v hh k j)
    (tendsto_crossMoment_finite hY Mf Mf hlaw)
  intro k ω
  rw [hθ k ω, poisson_decomposition_eq Q v hh hP (Y k ω) (Y (k + 1) ω)]
  rfl

/-! ### Noise generated by eligibility traces -/

section Traces

variable {m : ℕ} {ℱ : MeasureTheory.Filtration ℕ m0} {Y : ℕ → Ω → S} {Q : S → S → ℝ}

/-- The trace-driven noise `f k = F (Y k, Y (k+1)) z k + e (Y k, Y (k+1))`. -/
noncomputable def traceNoise (Fm : S → S → E m →L[ℝ] E d) (e : S → S → E d)
    (Y : ℕ → Ω → S) (z : ℕ → Ω → E m) (k : ℕ) (ω : Ω) : E d :=
  Fm (Y k ω) (Y (k + 1) ω) (z k ω) + e (Y k ω) (Y (k + 1) ω)

/-- The affine Poisson solution `H k = U (Y k) z k + ĥ (Y k)`. -/
noncomputable def tracePoisson (U : S → E m →L[ℝ] E d) (hh : S → E d) (Y : ℕ → Ω → S)
    (z : ℕ → Ω → E m) (k : ℕ) (ω : Ω) : E d :=
  U (Y k ω) (z k ω) + hh (Y k ω)

/-- Lemma 4.4 of the write-up: if `U = Σ_{y'} Q(·, y') (F(·, y') + c(y') U(y'))` and
`ĥ = Σ_{y'} Q(·, y') (e(·, y') + U(y') φ(y') + ĥ(y'))`, then
`M (k+1) = f k + H (k+1) - H k` is a martingale difference. -/
theorem condExp_traceMart_eq_zero [IsFiniteMeasure μ] (hY : FiniteMarkov μ ℱ Y Q)
    {z : ℕ → Ω → E m} {c : S → ℝ} {φ : S → E m}
    (hz : ∀ k, StronglyMeasurable[ℱ k] (z k)) (hzB : ∀ k, ∃ C, ∀ ω, ‖z k ω‖ ≤ C)
    (hzrec : ∀ k ω, z (k + 1) ω = c (Y (k + 1) ω) • z k ω + φ (Y (k + 1) ω))
    (Fm : S → S → E m →L[ℝ] E d) (e : S → S → E d) (U : S → E m →L[ℝ] E d) (hh : S → E d)
    (hU : ∀ y, U y = ∑ y', Q y y' • (Fm y y' + c y' • U y'))
    (hhh : ∀ y, hh y = ∑ y', Q y y' • (e y y' + U y' (φ y') + hh y')) (k : ℕ) (j : Fin d) :
    μ[fun ω => (traceNoise Fm e Y z k ω + tracePoisson U hh Y z (k + 1) ω
      - tracePoisson U hh Y z k ω) j | ℱ k] =ᵐ[μ] 0 := by
  -- write the component as `Σ_i z_i G_i(Y k, Y (k+1)) + G₀(Y k, Y (k+1))`
  set G : Fin m → S → S → ℝ := fun i y y' =>
    Fm y y' (EuclideanSpace.single i 1) j + c y' * U y' (EuclideanSpace.single i 1) j
      - U y (EuclideanSpace.single i 1) j with hG
  set G₀ : S → S → ℝ := fun y y' => e y y' j + U y' (φ y') j + hh y' j - hh y j with hG₀
  have hfun : (fun ω => (traceNoise Fm e Y z k ω + tracePoisson U hh Y z (k + 1) ω
      - tracePoisson U hh Y z k ω) j) =
      (∑ i, ((fun ω => z k ω i) * fun ω => G i (Y k ω) (Y (k + 1) ω)))
        + fun ω => G₀ (Y k ω) (Y (k + 1) ω) := by
    funext ω
    simp only [Pi.add_apply, Finset.sum_apply, Pi.mul_apply]
    simp only [traceNoise, tracePoisson, hzrec k ω, map_add, map_smul, PiLp.add_apply,
      PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul, hG, hG₀]
    rw [clm_apply_eq_sum (Fm (Y k ω) (Y (k + 1) ω)) (z k ω) j,
      clm_apply_eq_sum (U (Y (k + 1) ω)) (z k ω) j, clm_apply_eq_sum (U (Y k ω)) (z k ω) j]
    simp only [mul_add, mul_sub, sum_add_distrib, sum_sub_distrib, mul_sum]
    ring_nf
  -- integrability
  have hzi : ∀ i, StronglyMeasurable[ℱ k] fun ω => z k ω i := fun i =>
    (EuclideanSpace.proj (𝕜 := ℝ) i).continuous.comp_stronglyMeasurable (hz k)
  obtain ⟨Cz, hCz⟩ := hzB k
  have hzib : ∀ i ω, ‖z k ω i‖ ≤ Cz := fun i ω => (PiLp.norm_apply_le _ i).trans (hCz ω)
  have hGm : ∀ (H : S → S → ℝ), StronglyMeasurable fun ω => H (Y k ω) (Y (k + 1) ω) := by
    intro H
    have h1 : Measurable (Y k) := (hY.adapted k).mono (ℱ.le k) le_rfl
    have h2 : Measurable (Y (k + 1)) := (hY.adapted (k + 1)).mono (ℱ.le (k + 1)) le_rfl
    exact (StronglyMeasurable.of_discrete (f := Function.uncurry H)).comp_measurable
      (h1.prodMk h2)
  have hGi : ∀ (H : S → S → ℝ), Integrable (fun ω => H (Y k ω) (Y (k + 1) ω)) μ := by
    intro H
    refine (memLp_top_of_bound (hGm H).aestronglyMeasurable (∑ s, ∑ s', |H s s'|)
      (Eventually.of_forall fun ω => ?_)).integrable le_top
    rw [Real.norm_eq_abs]
    exact (single_le_sum (f := fun s' => |H (Y k ω) s'|) (fun _ _ => abs_nonneg _)
      (mem_univ _)).trans (single_le_sum (f := fun s => ∑ s', |H s s'|)
        (fun _ _ => sum_nonneg fun _ _ => abs_nonneg _) (mem_univ _))
  have hprod : ∀ i, Integrable ((fun ω => z k ω i) * fun ω => G i (Y k ω) (Y (k + 1) ω)) μ := by
    intro i
    have := (hGi (G i)).bdd_mul ((hzi i).mono (ℱ.le k)).aestronglyMeasurable ⟨Cz, hzib i⟩
    exact this
  -- the conditional expectation term by term
  have hterm : ∀ i, μ[(fun ω => z k ω i) * fun ω => G i (Y k ω) (Y (k + 1) ω) | ℱ k] =ᵐ[μ]
      fun ω => z k ω i * ∑ y', Q (Y k ω) y' * G i (Y k ω) y' := by
    intro i
    filter_upwards [condExp_mul_of_stronglyMeasurable_left (hzi i) (hprod i) (hGi (G i)),
      hY.markov k (G i)] with ω h1 h2
    rw [h1, Pi.mul_apply, h2]
  have hsum := condExp_finset_sum (s := univ) (μ := μ) (fun i _ => hprod i) (ℱ k)
  have hsumI : Integrable (∑ i, ((fun ω => z k ω i) * fun ω => G i (Y k ω) (Y (k + 1) ω))) μ :=
    integrable_finset_sum' univ fun i _ => hprod i
  have hadd := condExp_add hsumI (hGi G₀) (ℱ k) (μ := μ)
  -- the coefficients vanish by the Poisson equations
  have hzero : ∀ y i, ∑ y', Q y y' * G i y y' = 0 := by
    intro y i
    have := congrArg (fun L : E m →L[ℝ] E d => L (EuclideanSpace.single i 1) j) (hU y)
    simp only [ContinuousLinearMap.coe_sum', Finset.sum_apply, ContinuousLinearMap.coe_smul',
      Pi.smul_apply, ContinuousLinearMap.add_apply, euclid_sum_apply', PiLp.smul_apply,
      PiLp.add_apply, smul_eq_mul] at this
    simp only [hG, mul_sub, mul_add, sum_sub_distrib, sum_add_distrib, ← sum_mul, hY.stochastic,
      one_mul]
    simp only [mul_add, sum_add_distrib] at this
    linarith
  have hzero₀ : ∀ y, ∑ y', Q y y' * G₀ y y' = 0 := by
    intro y
    have := congrArg (fun x : E d => x j) (hhh y)
    simp only [euclid_sum_apply', PiLp.smul_apply, PiLp.add_apply, smul_eq_mul] at this
    simp only [hG₀, mul_sub, mul_add, sum_sub_distrib, sum_add_distrib, ← sum_mul, hY.stochastic,
      one_mul]
    simp only [mul_add, sum_add_distrib] at this
    linarith
  rw [hfun]
  filter_upwards [hadd, hsum, ae_all_iff.mpr hterm, hY.markov k G₀] with ω h1 h2 h3 h4
  rw [h1, Pi.add_apply, h2, Finset.sum_apply, h4, hzero₀]
  simp [h3, hzero]

omit [MeasurableSpace S] [DiscreteMeasurableSpace S] in
lemma norm_le_sum_gen {X : Type*} [SeminormedAddCommGroup X] (f : S → X) (a : S) :
    ‖f a‖ ≤ ∑ s, ‖f s‖ :=
  single_le_sum (f := fun s => ‖f s‖) (fun _ _ => norm_nonneg _) (mem_univ a)

omit [MeasurableSpace S] [DiscreteMeasurableSpace S] in
lemma norm_le_sum_sum_gen {X : Type*} [SeminormedAddCommGroup X] (f : S → S → X) (a b : S) :
    ‖f a b‖ ≤ ∑ s, ∑ s', ‖f s s'‖ :=
  (norm_le_sum_gen (f a) b).trans (single_le_sum (f := fun s => ∑ s', ‖f s s'‖)
    (fun _ _ => sum_nonneg fun _ _ => norm_nonneg _) (mem_univ a))

/-- **Corollary 4.5 of the write-up.** Linear stochastic approximation driven by trace noise,
`θ (k+1) = θ k - β k A θ k + β k (F (Y k, Y (k+1)) z k + e (Y k, Y (k+1)))`, with bounded
traces `z (k+1) = c (Y (k+1)) z k + φ (Y (k+1))` and the affine Poisson solution of
Lemma 4.4, satisfies Theorem 2.1 with `Γ = lim E[M Mᵀ]`. -/
theorem tendsto_secondMoment_of_trace_noise [IsProbabilityMeasure μ] {β : ℕ → ℝ} {βbar : ℝ}
    (hβ : StepSizeRate β βbar) (A : Matrix (Fin d) (Fin d) ℝ) {η : ℝ} (hη : 0 < η)
    (hA : ∀ x, η * (x ⬝ᵥ x) ≤ x ⬝ᵥ ((A - (βbar / 2) • 1) *ᵥ x))
    (hY : FiniteMarkov μ ℱ Y Q) {z : ℕ → Ω → E m} {c : S → ℝ} {φ : S → E m} {Cz : ℝ}
    (hz : ∀ k, StronglyMeasurable[ℱ k] (z k)) (hzB : ∀ k ω, ‖z k ω‖ ≤ Cz)
    (hzrec : ∀ k ω, z (k + 1) ω = c (Y (k + 1) ω) • z k ω + φ (Y (k + 1) ω))
    (Fm : S → S → E m →L[ℝ] E d) (e : S → S → E d) (U : S → E m →L[ℝ] E d) (hh : S → E d)
    (hU : ∀ y, U y = ∑ y', Q y y' • (Fm y y' + c y' • U y'))
    (hhh : ∀ y, hh y = ∑ y', Q y y' • (e y y' + U y' (φ y') + hh y')) {Γ : Mat d}
    (hΓ : Tendsto (fun k => secondMoment μ (fun ω => traceNoise Fm e Y z k ω
      + tracePoisson U hh Y z (k + 1) ω - tracePoisson U hh Y z k ω)) atTop (𝓝 Γ))
    {θ : ℕ → Ω → E d}
    (hθ : ∀ k ω, θ (k + 1) ω = θ k ω - β k • matCLM A (θ k ω) + β k • traceNoise Fm e Y z k ω)
    (hθ0 : StronglyMeasurable[ℱ 0] (θ 0)) (hθ0L : MemLp (θ 0) 2 μ) :
    ∃ Sig, lyapOp (A - (βbar / 2) • 1) Sig = Γ ∧
      Tendsto (fun k => (β k)⁻¹ • secondMoment μ (θ k)) atTop (𝓝 Sig) := by
  -- bounds
  set CU := ∑ s, ‖U s‖
  set CF := ∑ s, ∑ s', ‖Fm s s'‖
  set Ce := ∑ s, ∑ s', ‖e s s'‖
  set Ch := ∑ s, ‖hh s‖
  have hCz : ∀ k ω, 0 ≤ ‖z k ω‖ := fun _ _ => norm_nonneg _
  have bH : ∀ k ω, ‖tracePoisson U hh Y z k ω‖ ≤ CU * Cz + Ch := by
    intro k ω
    refine (norm_add_le _ _).trans (add_le_add ?_ (norm_le_sum_gen hh _))
    exact ((U (Y k ω)).le_opNorm _).trans (mul_le_mul (norm_le_sum_gen U _) (hzB k ω)
      (norm_nonneg _) (sum_nonneg fun _ _ => norm_nonneg _))
  have bf : ∀ k ω, ‖traceNoise Fm e Y z k ω‖ ≤ CF * Cz + Ce := by
    intro k ω
    refine (norm_add_le _ _).trans (add_le_add ?_ (norm_le_sum_sum_gen e _ _))
    exact ((Fm _ _).le_opNorm _).trans (mul_le_mul (norm_le_sum_sum_gen Fm _ _) (hzB k ω)
      (norm_nonneg _) (sum_nonneg fun _ _ => sum_nonneg fun _ _ => norm_nonneg _))
  -- measurability
  have mY : ∀ k, Measurable[ℱ k] (Y k) := hY.adapted
  have smH : ∀ k, StronglyMeasurable[ℱ k] (tracePoisson U hh Y z k) := fun k => by
    unfold tracePoisson
    exact (stronglyMeasurable_clm_apply (m := ℱ k) ((StronglyMeasurable.of_discrete (f := U)).comp_measurable (mY k))
      (hz k)).add (hY.stronglyMeasurable hh k)
  have smf : ∀ k, StronglyMeasurable[ℱ (k + 1)] (traceNoise Fm e Y z k) := by
    intro k
    have h1 : Measurable[ℱ (k + 1)] (Y k) := (mY k).mono (ℱ.mono (Nat.le_succ k)) le_rfl
    have h2 := h1.prodMk (mY (k + 1))
    have hL : StronglyMeasurable[ℱ (k + 1)] fun ω => Fm (Y k ω) (Y (k + 1) ω) :=
      (StronglyMeasurable.of_discrete (f := Function.uncurry Fm)).comp_measurable h2
    unfold traceNoise
    exact (stronglyMeasurable_clm_apply (m := ℱ (k + 1)) hL ((hz k).mono (ℱ.mono (Nat.le_succ k)))).add
      (hY.stronglyMeasurable₂ e k)
  have smM : ∀ k, StronglyMeasurable[ℱ (k + 1)] fun ω => traceNoise Fm e Y z k ω
      + tracePoisson U hh Y z (k + 1) ω - tracePoisson U hh Y z k ω := fun k =>
    ((smf k).add (smH (k + 1))).sub ((smH k).mono (ℱ.mono (Nat.le_succ k)))
  have bM : ∀ k ω, ‖traceNoise Fm e Y z k ω + tracePoisson U hh Y z (k + 1) ω
      - tracePoisson U hh Y z k ω‖ ≤ CF * Cz + Ce + 2 * (CU * Cz + Ch) := by
    intro k ω
    have t1 := norm_sub_le (traceNoise Fm e Y z k ω + tracePoisson U hh Y z (k + 1) ω)
      (tracePoisson U hh Y z k ω)
    have t2 := norm_add_le (traceNoise Fm e Y z k ω) (tracePoisson U hh Y z (k + 1) ω)
    linarith [bf k ω, bH (k + 1) ω, bH k ω]
  have hHL : ∀ k, MemLp (tracePoisson U hh Y z k) 2 μ := fun k =>
    memLp_of_finite ((smH k).mono (ℱ.le k)).aestronglyMeasurable (bH k)
  have hML : ∀ k, MemLp (fun ω => traceNoise Fm e Y z k ω + tracePoisson U hh Y z (k + 1) ω
      - tracePoisson U hh Y z k ω) 2 μ := fun k =>
    memLp_of_finite ((smM k).mono (ℱ.le (k + 1))).aestronglyMeasurable (bM k)
  have sqB : ∀ {g : Ω → E d} {C : ℝ}, (∀ ω, ‖g ω‖ ≤ C) → ∫ ω, ‖g ω‖ ^ 2 ∂μ ≤ C ^ 2 := by
    intro g C hC
    calc ∫ ω, ‖g ω‖ ^ 2 ∂μ ≤ ∫ _ω, C ^ 2 ∂μ :=
          integral_mono_of_nonneg (Eventually.of_forall fun _ => by positivity)
            (integrable_const _) (Eventually.of_forall fun ω =>
              pow_le_pow_left₀ (norm_nonneg _) (hC ω) 2)
      _ = C ^ 2 := by simp
  refine tendsto_secondMoment_of_markov_noise hβ A hη hA ℱ
    (M := fun n ω => traceNoise Fm e Y z n.pred ω + tracePoisson U hh Y z n ω
      - tracePoisson U hh Y z n.pred ω) (h := tracePoisson U hh Y z) ?_ hθ0 hθ0L smH hHL
    ⟨_, fun k => sqB (bH k)⟩ smM hML ⟨_, fun k => sqB (bM k)⟩
    (fun k j => condExp_traceMart_eq_zero hY hz (fun k => ⟨Cz, hzB k⟩) hzrec Fm e U hh hU hhh k j)
    hΓ
  intro k ω
  rw [hθ k ω]
  congr 2
  simp only [Nat.pred_succ]
  abel

end Traces

end StochasticApproximation
